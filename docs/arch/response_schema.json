{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://ai-proofread.nvim/response/v3",
  "title": "AI Proofread Response Schema",
  "description": "Response contract for ai-proofread.nvim findings",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["correction"]
          },
          "category": {
            "type": "string",
            "enum": [
              "spelling",
              "grammar",
              "punctuation"
            ]
          },
          "original": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["type", "category", "original", "suggestion", "message"],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": ["findings"],
  "additionalProperties": false
}
